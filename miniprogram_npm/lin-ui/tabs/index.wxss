    flex-direction: column;
    width: 160rpx
}

.l-placement-left .l-tabs-header>.l-tabs-item,.l-placement-right .l-tabs-header>.l-tabs-item {
    background: #f6f8fa;
    height: 80rpx;
    width: 100%
}

.l-placement-left .l-tabs-header>.l-tabs-active,.l-placement-right .l-tabs-header>.l-tabs-active {
    background: #fff
}

.l-placement-right {
    -webkit-flex-direction: row-reverse;
    flex-direction: row-reverse
}

.l-placement-bottom {
    -webkit-flex-direction: column-reverse;
    flex-direction: column-reverse
}

.l-tabpanel-content {
    display: -webkit-flex;
    display: flex
}

.l-placement-left .l-tabpanel-content,.l-placement-right .l-tabpanel-content {
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    -webkit-flex-direction: column;
    flex-direction: column;
    position: relative;
    transition: -webkit-transform .3s cubic-bezier(.645,.045,.355,1);
    transition: transform .3s cubic-bezier(.645,.045,.355,1);
    transition: transform .3s cubic-bezier(.645,.045,.355,1),-webkit-transform .3s cubic-bezier(.645,.045,.355,1);
    width: 100%;
    will-change: transform
}

.l-placement-bottom .l-tabpanel-content,.l-placement-top .l-tabpanel-content {
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-flex-direction: row;
    -ms-flex-direction: row;
    flex-direction: row;
    min-height: 100%;
    width: 100%
}

.l-aminmated.l-placement-bottom .l-tabpanel-content,.l-aminmated.l-placement-top .l-tabpanel-content {
    -webkit-transition: margin-left .3s cubic-bezier(.645,.045,.355,1);
    transition: margin-left .3s cubic-bezier(.645,.045,.355,1);
    will-change: margin-left
}

.l-tabpanel {
    -ms-flex-negative: 0;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    height: 100%;
    opacity: 1;
    text-overflow: ellipsis;
    width: 100%
}

.l-tabpanel-inactive {
    height: 0;
    opacity: 0;
    padding: 0!important;
    pointer-events: none
}

.l-tabs-scroll.l-tabs-horizontal .l-tabs-header {
    -webkit-overflow-scrolling: touch;
    white-space: nowrap
}

.l-tabs-scroll.l-tabs-horizontal .l-tabs-header .l-tabs-item {
