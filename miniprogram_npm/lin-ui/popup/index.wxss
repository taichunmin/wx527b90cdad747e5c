.container-popup {
    bottom: 0;
    left: 0;
    position: fixed;
    right: 0;
    top: 0
}

.container-bg-show {
    -webkit-animation: bg-fadein .3s forwards;
    animation: bg-fadein .3s forwards
}

.container-bg-hide {
    -webkit-animation: bg-fadeout .3s forwards;
    animation: bg-fadeout .3s forwards
}

.container-bg {
    background: rgba(0,0,0,.4);
    bottom: 0;
    display: block;
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 6
}

.popup-content {
    height: 100%;
    max-width: 100%;
    position: absolute;
    width: 100%;
    z-index: 100
}

.center {
    -webkit-align-items: center;
    align-items: center;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100%
}

.center,.left,.right {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 100%
}

.right {
    -webkit-justify-content: flex-end;
    justify-content: flex-end
}

.bottom {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column-reverse;
    flex-direction: column-reverse;
    width: 100%
}
