.container,page {
    background-color: #f5f5f5
}

.container {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    padding: 20px
}

.text-wrapper {
    color: #333;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 20px;
    text-align: justify
}

.shop-list-title {
    color: #333;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 10px
}

.image-wrapper {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100%
}

wx-image {
    max-width: 500px;
    width: 100%
}

.table {
    display: block;
    width: 100%
}

.table-header,.table-row {
    background-color: #f0f0f0;
    border-bottom: 1px solid #ddd;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 10px
}

.table-header {
    font-weight: 700
}

.cell {
    -webkit-flex: 1;
    flex: 1;
    text-align: center
}
